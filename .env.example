# ── IMAP (reading email) ─────────────────────────────────────────────
# Works with any standard IMAP-over-SSL provider: Gmail, Outlook/Microsoft 365,
# Yahoo, iCloud, Zoho, or most corporate mail servers.
# Most providers require an APP-SPECIFIC PASSWORD here, not your normal login
# password (see README.md for per-provider instructions).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX

# ── SMTP (sending your approved reply drafts) ────────────────────────
# Leave SMTP_USER / SMTP_PASSWORD blank to reuse the IMAP credentials above.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false

# ── AI provider (bring your own API key) ──────────────────────────────
# Choose one: anthropic | openai | gemini | custom
# Only that provider's key/model below is required — the rest can stay empty.
LLM_PROVIDER=anthropic

# anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# openai — https://platform.openai.com/
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# gemini — free tier available at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# custom — ANY OpenAI-compatible endpoint (many have free tiers):
#   Groq:       https://api.groq.com/openai/v1   (free tier)
#   OpenRouter: https://openrouter.ai/api/v1      (many free models)
#   Ollama (local, fully free): http://localhost:11434/v1  (CUSTOM_API_KEY can be anything, e.g. "ollama")
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ── Filters ────────────────────────────────────────────────────────────
# Only emails matching these filters are analyzed. Comma-separated.
WATCH_SENDERS=boss@example.com,billing@vendor.com
WATCH_KEYWORDS=urgent,invoice,contract
# any = match sender OR keyword. all = match sender AND keyword (only applies
# when both WATCH_SENDERS and WATCH_KEYWORDS are set).
MATCH_MODE=any

# Mark matched emails as read after processing? (true/false)
MARK_AS_READ=false

# Where drafts, reports, and the processed-message log are stored
DATA_DIR=./data
